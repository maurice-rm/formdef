{
  "extends": "@formdef/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/ui/*": ["../../packages/shadcn/components/ui/*"],
      "@/components/formdef/*": ["../../packages/shadcn/components/formdef/*"],
      "@/hooks/formdef/*": ["../../packages/shadcn/hooks/formdef/*"],
      "@/lib/formdef/*": ["../../packages/shadcn/lib/formdef/*"],
      "@/*": ["./*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out"]
}
