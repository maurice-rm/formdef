    {
      "name": "number-field",
      "type": "registry:component",
      "title": "Number field",
      "description": "A formdef widget for optional number values, built on shadcn's Field and Input; an empty input is undefined.",
      "dependencies": ["@formdef/core"],
      "registryDependencies": ["field", "input"],
      "files": [
        {
          "path": "components/formdef/field-frame.tsx",
          "type": "registry:component",
          "target": "@components/formdef/field-frame.tsx"
        },
        {
          "path": "components/formdef/field-notes.tsx",
          "type": "registry:component",
