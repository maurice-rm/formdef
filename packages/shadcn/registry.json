{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "formdef",
  "homepage": "https://github.com/maurice-rm/formdef",
  "items": [
    {
      "name": "formdef",
      "type": "registry:lib",
      "title": "formdef setup",
      "description": "The wiring every formdef form needs: the TanStack contexts in one file, the registry that names your widgets in another.",
      "dependencies": ["@formdef/core", "@tanstack/react-form@>=1.33.5 <1.34.0"],
      "registryDependencies": ["field"],
      "files": [
        {
          "path": "lib/formdef/context.ts",
          "type": "registry:lib",
          "target": "@lib/formdef/context.ts"
        },
        {
          "path": "lib/formdef/index.tsx",
          "type": "registry:lib",
          "target": "@lib/formdef/index.tsx"
        }
      ],
      "docs": "Fetch this first. It lands in lib/formdef/: context.ts holds the TanStack contexts, index.tsx the registry, so you import @/lib/formdef. Add an entry under widgets for every widget you fetch, then build forms with the createForm it exports.",
      "categories": ["form"]
    },
    {
      "name": "text-field",
      "type": "registry:component",
      "title": "Text field",
      "description": "A formdef widget for string values, built on shadcn's Field and Input, with optional addons in an input group.",
      "dependencies": ["@formdef/core"],
      "registryDependencies": ["field", "input", "input-group"],
      "files": [
        {
          "path": "components/formdef/field-frame.tsx",
          "type": "registry:component",
          "target": "@components/formdef/field-frame.tsx"
        },
        {
          "path": "components/formdef/field-notes.tsx",
          "type": "registry:component",
          "target": "@components/formdef/field-notes.tsx"
        },
        {
          "path": "components/formdef/label-line.tsx",
          "type": "registry:component",
          "target": "@components/formdef/label-line.tsx"
        },
        {
          "path": "components/formdef/text-field.tsx",
          "type": "registry:component",
          "target": "@components/formdef/text-field.tsx"
        },
        {
          "path": "lib/formdef/addons.ts",
          "type": "registry:lib",
          "target": "@lib/formdef/addons.ts"
        },
        {
          "path": "lib/formdef/field-labels.ts",
          "type": "registry:lib",
          "target": "@lib/formdef/field-labels.ts"
        }
      ],
      "docs": "Register it in lib/formdef: widgets: { text: TextField }.",
      "categories": ["form", "field"]
    },
