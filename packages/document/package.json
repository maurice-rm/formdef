{
  "name": "@formdef/document",
  "version": "0.0.0",
  "private": true,
  "description": "Describe a form as data, a form document, and turn it into a formdef form at runtime: for form builders and forms stored in a database.",
  "keywords": [
    "react",
    "form",
    "forms",
    "form-builder",
    "json",
    "tanstack-form",
    "shadcn",
    "standard-schema",
    "typescript"
  ],
  "license": "MIT",
  "author": "Maurice Reim",
  "homepage": "https://formdef.mauricereim.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurice-rm/formdef.git",
    "directory": "packages/document"
  },
  "bugs": "https://github.com/maurice-rm/formdef/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only"
  },
  "peerDependencies": {
    "@formdef/core": "workspace:^",
    "react": "^19.0.0",
    "typescript": ">=5.7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@formdef/core": "workspace:*",
    "@formdef/tsconfig": "workspace:*",
    "@tanstack/react-form": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "publint": "0.3.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "0.23.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "@formdef/source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "@formdef/source": "./src/react/index.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./react": {
        "import": "./dist/react.js",
        "require": "./dist/react.cjs"
      },
      "./package.json": "./package.json"
    }
  }
}
