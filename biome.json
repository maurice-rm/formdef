{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!pnpm-lock.yaml", "!**/*.md", "!packages/shadcn/components/ui", "!examples"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "performance": {
        "noReExportAll": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": ["camelCase", "PascalCase"]
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "formats": ["camelCase", "PascalCase"]
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": false
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test-d.ts", "**/*.test-d.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/widget/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/config",
                      "**/config/**",
                      "**/render",
                      "**/render/**",
                      "**/form",
                      "**/form/**",
                      "**/registry",
                      "**/registry/**"
                    ],
                    "message": "formdef: widget/ is the innermost module and imports no other"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/config/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/render",
                      "**/render/**",
                      "**/form",
                      "**/form/**",
                      "**/registry",
                      "**/registry/**"
                    ],
                    "message": "formdef: config/ imports only from widget/"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/form/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/registry", "**/registry/**"],
                    "message": "formdef: form/ imports from render/, config/ and widget/ only"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/render/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/form", "**/form/**", "**/registry", "**/registry/**"],
                    "message": "formdef: render/ imports only from config/ and widget/"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/document/src/**", "!packages/document/src/react/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./react", "./react/**", "../react", "../react/**"],
                    "message": "formdef: the root entry of @formdef/document runs on a server; it imports nothing from react/"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/document/src/validate/**",
        "packages/document/src/describe/**",
        "packages/document/src/edit/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../react", "../react/**"],
                    "message": "formdef: the root entry of @formdef/document runs on a server; it imports nothing from react/"
                  },
                  {
                    "group": [
                      "../validate",
                      "../validate/**",
                      "../describe",
                      "../describe/**",
                      "../edit",
                      "../edit/**"
                    ],
                    "message": "formdef: validate/, describe/ and edit/ import from evaluate/, check/, kinds/, read/ and the root files, not from each other"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/document/src/evaluate/**", "packages/document/src/check/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../react", "../react/**"],
                    "message": "formdef: the root entry of @formdef/document runs on a server; it imports nothing from react/"
                  },
                  {
                    "group": [
                      "../validate",
                      "../validate/**",
                      "../describe",
                      "../describe/**",
                      "../edit",
                      "../edit/**",
                      "../evaluate",
                      "../evaluate/**",
                      "../check",
                      "../check/**"
                    ],
                    "message": "formdef: evaluate/ and check/ import from kinds/, read/ and the root files only"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/document/src/kinds/**", "packages/document/src/read/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../react", "../react/**"],
                    "message": "formdef: the root entry of @formdef/document runs on a server; it imports nothing from react/"
                  },
                  {
                    "group": [
                      "../validate",
                      "../validate/**",
                      "../describe",
                      "../describe/**",
                      "../edit",
                      "../edit/**",
                      "../evaluate",
                      "../evaluate/**",
                      "../check",
                      "../check/**",
                      "../kinds",
                      "../kinds/**",
                      "../read",
                      "../read/**"
                    ],
                    "message": "formdef: kinds/ and read/ import from the root files only"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/document/src/*.ts", "!packages/document/src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./react", "./react/**"],
                    "message": "formdef: the root entry of @formdef/document runs on a server; it imports nothing from react/"
                  },
                  {
                    "group": [
                      "./validate",
                      "./validate/**",
                      "./describe",
                      "./describe/**",
                      "./edit",
                      "./edit/**",
                      "./evaluate",
                      "./evaluate/**",
                      "./check",
                      "./check/**",
                      "./kinds",
                      "./kinds/**",
                      "./read",
                      "./read/**"
                    ],
                    "message": "formdef: the root files of @formdef/document import from no folder of it"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
