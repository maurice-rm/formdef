{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "packages/integration": {
      "entry": ["src/consumer.ts", "src/consumer.cts", "src/form.tsx", "src/registry.tsx"]
    },
    "packages/core": {
      "vitest": {
        "entry": ["src/**/*.test.{ts,tsx}", "src/**/*.test-d.{ts,tsx}"]
      }
    },
    "packages/shadcn": {
      "entry": ["lib/formdef/*.{ts,tsx}", "components/formdef/*.tsx"],
      "ignore": ["components/ui/**"],
      "vitest": {
        "entry": ["tests/**/*.test.{ts,tsx}", "tests/**/*.test-d.{ts,tsx}"]
      }
    }
  }
}
