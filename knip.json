{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "packages/integration": {
      "entry": [
        "src/consumer.ts",
        "src/consumer.cts",
        "src/form.tsx",
        "src/registry.tsx",
        "src/type-cost/form.ts",
        "src/type-cost/no-form.ts"
      ]
    },
    "packages/core": {
      "vitest": {
        "entry": ["src/**/*.test.{ts,tsx}", "src/**/*.test-d.{ts,tsx}"]
      }
    },
    "packages/shadcn": {
      "entry": ["lib/formdef/*.{ts,tsx}", "components/formdef/*.tsx", "hooks/formdef/*.ts"],
      "ignore": ["components/ui/**"],
      "vitest": {
        "entry": ["tests/**/*.test.{ts,tsx}", "tests/**/*.test-d.{ts,tsx}"]
      }
    },
    "apps/docs": {
      "ignoreDependencies": ["@formdef/core", "@tanstack/react-form"]
    }
  }
}
